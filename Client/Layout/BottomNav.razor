@inject NavigationManager Navigation

<nav class="bottom-nav">
    <a href="/home" class="nav-item @GetActiveClass("/home")" data-testid="nav-scan">
        <span class="nav-icon">🏠</span>
        <span class="nav-label">Home</span>
    </a>
    <a href="/collection" class="nav-item @GetActiveClass("/collection")" data-testid="nav-collection">
        <span class="nav-icon">📦</span>
        <span class="nav-label">Collection</span>
    </a>
    <a href="/giftshop" class="nav-item @GetActiveClass("/giftshop")" data-testid="nav-store">
        <span class="nav-icon">🪙</span>
        <span class="nav-label">Gift Shop</span>
    </a>
    <a href="/games" class="nav-item @GetActiveClass("/games")" data-testid="nav-games">
        <span class="nav-icon">🧩</span>
        <span class="nav-label">Games</span>
    </a>
    <a href="/profile" class="nav-item @GetActiveClass("/profile")" data-testid="nav-profile">
        <span class="nav-icon">👤</span>
        <span class="nav-label">Profile</span>
    </a>
</nav>

@code {
    private string GetActiveClass(string path)
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        // Normalize /home to / for comparison
        // if (currentPath == "/home") currentPath = "/";
        return currentPath == path ? "active" : "";
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += (s, e) => StateHasChanged();
    }
}
