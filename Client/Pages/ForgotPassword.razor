@page "/forgot-password"
@using AnimalCollector.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>Forgot Password - Yume Zoo</PageTitle>

<div class="page-container auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon">🔐</div>
            <h1>Forgot Password</h1>
            <p>Enter your email and we'll send you a reset link</p>
        </div>

        @if (submitted)
        {
            <div class="success-message">
                <div class="success-icon">✉️</div>
                <p>@message</p>
                <button class="btn-primary" @onclick="GoToLogin">Back to Login</button>
            </div>
        }
        else
        {
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" 
                           id="email" 
                           @bind="email" 
                           placeholder="your@email.com"
                           required
                           disabled="@isLoading" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-message">@errorMessage</div>
                }

                <button type="submit" class="btn-primary" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send Reset Link</span>
                    }
                </button>
            </form>

            <div class="auth-footer">
                <p>Remember your password? <a href="#/profile" @onclick="GoToLogin" @onclick:preventDefault>Log in</a></p>
            </div>
        }
    </div>
</div>

@code {
    private string email = "";
    private string message = "";
    private string errorMessage = "";
    private bool isLoading = false;
    private bool submitted = false;

    private async Task HandleSubmit()
    {
        errorMessage = "";
        isLoading = true;

        try
        {
            var request = new ForgotPasswordRequest { Email = email };
            var response = await Http.PostAsJsonAsync("api/auth/forgot-password", request);
            var result = await response.Content.ReadFromJsonAsync<AuthResponse>();

            if (result?.Success == true)
            {
                message = result.Message;
                submitted = true;
            }
            else
            {
                errorMessage = result?.Message ?? "Failed to send reset email";
            }
        }
        catch (Exception)
        {
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/profile");
    }
}
