@page "/giftshop"
@inject HttpClient Http
@inject AuthService AuthService

<PageTitle>Gift Shop - Yume Zoo</PageTitle>

<div class="page-container">
    @if (!AuthService.IsAuthenticated)
    {
        <div class="auth-required">
            <div class="lock-icon">🔒</div>
            <h2>Gift Shop is Locked</h2>
            <p>Create an account to start building your animal collection!</p>
            <button class="btn-primary" @onclick="ShowAuth" data-testid="button-login-to-view">
                Login to View Gift Shop
            </button>
        </div>
    }
    else
    {
        <div class="collection-content">
            <h1 class="hero-title">Welcome to the Yume Zoo Gift Shop</h1>
            
            <div class="token-balance">
                <span class="token-icon">🪙</span>
                <span class="token-amount">@AuthService.CurrentUser?.Tokens ?? 0 Tokens</span>
            </div>

            @if (isLoading)
            {
                <div class="loading">Stocking the gift shop...</div>
            }
            else if (gifts.Count > 0)
            {
                <div class="store-items-grid">
                    @foreach (var gift in gifts)
                    {
                        <div class="gift-card">
                            <div class="gift-image-container">
                                @if (!string.IsNullOrEmpty(gift.ImageUrl))
                                {
                                    <img src="@gift.ImageUrl" alt="@gift.Name" class="gift-image" />
                                }
                                else
                                {
                                    <div class="gift-placeholder">🎁</div>
                                }
                            </div>
                            <div class="gift-info">
                                <h3 class="gift-name">@gift.Name</h3>
                                <div class="gift-price">
                                    <span class="token-icon">🪙</span>
                                    <span>@gift.Price</span>
                                </div>
                                @if (AuthService.CurrentUser?.Tokens >= gift.Price)
                                {
                                    <button class="btn-purchase" @onclick="() => PurchaseGift(gift)">
                                        Purchase
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-purchase btn-disabled" disabled>
                                        Not Enough Tokens
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <p>No gifts available at the moment.</p>
                </div>
            }
        </div>
        
        @if (showPurchaseSuccess)
        {
            <div class="modal-overlay" @onclick="() => showPurchaseSuccess = false">
                <div class="modal-content success-modal" @onclick:stopPropagation="true">
                    <button class="modal-close" @onclick="() => showPurchaseSuccess = false">×</button>
                    <div class="success-icon">✨</div>
                    <h2>Purchase Successful!</h2>
                    <p>@purchaseMessage</p>
                    <p class="remaining-tokens">Remaining Tokens: 🪙 @(AuthService.CurrentUser?.Tokens ?? 0)</p>
                    <button class="btn-primary" @onclick="() => showPurchaseSuccess = false">Continue Shopping</button>
                </div>
            </div>
        }
        
        @if (showPurchaseError)
        {
            <div class="modal-overlay" @onclick="() => showPurchaseError = false">
                <div class="modal-content error-modal" @onclick:stopPropagation="true">
                    <button class="modal-close" @onclick="() => showPurchaseError = false">×</button>
                    <div class="error-icon">❌</div>
                    <h2>Purchase Failed</h2>
                    <p>@purchaseErrorMessage</p>
                    <button class="btn-primary" @onclick="() => showPurchaseError = false">Try Again</button>
                </div>
            </div>
        }
    }


    @if (showAuthModal)
    {
        <div class="modal-overlay" @onclick="CloseAuthModal">
            <div class="modal-content auth-modal" @onclick:stopPropagation="true">
                <button class="modal-close" @onclick="CloseAuthModal">×</button>
                <h2>@(isLogin ? "Login" : "Sign Up")</h2>
                
                <div class="auth-form">
                    <input type="email" placeholder="Email Address" @bind="username" data-testid="input-username" />
                    <input type="password" placeholder="Password" @bind="password" data-testid="input-password" />
                    @if (!isLogin)
                    {
                        <input type="text" placeholder="Nickname (3-20 characters)" @bind="nickname" data-testid="input-nickname" />
                    }
                    
                    @if (!string.IsNullOrEmpty(authError))
                    {
                        <p class="error">@authError</p>
                    }

                    <button class="btn-primary" @onclick="HandleAuth" data-testid="button-submit-auth">
                        @(isLogin ? "Login" : "Sign Up")
                    </button>
                    
                    @if (availableProviders.Any())
                    {
                        <div class="auth-divider">
                            <span>or continue with</span>
                        </div>

                        <div class="external-auth-buttons">
                            @if (availableProviders.Contains("Google"))
                            {
                                <a href="/api/auth/external-login?provider=Google&returnUrl=/collection" class="btn-external-auth btn-google" data-testid="button-google-signin">
                                    <img src="https://www.google.com/favicon.ico" alt="Google" />
                                    <span>Google</span>
                                </a>
                            }
                            @if (availableProviders.Contains("Apple"))
                            {
                                <a href="/api/auth/external-login?provider=Apple&returnUrl=/collection" class="btn-external-auth btn-apple" data-testid="button-apple-signin">
                                    <img src="https://www.apple.com/favicon.ico" alt="Apple" />
                                    <span>Apple</span>
                                </a>
                            }
                        </div>
                    }
                    
                    <button class="btn-text" @onclick="ToggleAuthMode">
                        @(isLogin ? "Need an account? Sign up" : "Have an account? Login")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
 
    private bool isLoading = true;
    private bool showAnimalModal = false;
    private bool showAuthModal = false;
    private bool showPurchaseSuccess = false;
    private bool showPurchaseError = false;
    private bool isLogin = true;
    private string username = "";
    private string password = "";
    private string nickname = "";
    private string authError = "";
    private string purchaseMessage = "";
    private string purchaseErrorMessage = "";
    private List<string> availableProviders = new();
    private List<GiftDTO> gifts = new();

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnAuthStateChanged += OnAuthChanged;        
        await LoadAvailableProviders();
        await LoadGifts();
    }

    private async Task LoadAvailableProviders()
    {
        try
        {
            availableProviders = await Http.GetFromJsonAsync<List<string>>("/api/auth/providers") ?? new();
        }
        catch
        {
            availableProviders = new();
        }
    }

    private async Task LoadGifts()
    {
        try
        {
            isLoading = true;
            gifts = await Http.GetFromJsonAsync<List<GiftDTO>>("/api/gifts") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading gifts: {ex.Message}");
            gifts = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PurchaseGift(GiftDTO gift)
    {
        try
        {
            var request = new { GiftId = int.Parse(gift.Id) };
            var response = await Http.PostAsJsonAsync("/api/gifts/purchase", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PurchaseResponse>();
                if (result != null)
                {
                    purchaseMessage = result.Message;
                    
                    // Update user's token count
                    if (AuthService.CurrentUser != null)
                    {
                        AuthService.CurrentUser.Tokens = result.RemainingTokens;
                    }
                    
                    showPurchaseSuccess = true;
                    StateHasChanged();
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorObj = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                    purchaseErrorMessage = errorObj?.Message ?? "Purchase failed. Please try again.";
                }
                catch
                {
                    purchaseErrorMessage = "Purchase failed. Please try again.";
                }
                showPurchaseError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Purchase error: {ex.Message}");
            purchaseErrorMessage = "An error occurred. Please try again.";
            showPurchaseError = true;
        }
    }

    private class ErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }

    private async void OnAuthChanged()
    {
        await LoadGifts();
        StateHasChanged();
    }

    private class PurchaseResponse
    {
        public string Message { get; set; } = string.Empty;
        public int RemainingTokens { get; set; }
        public string GiftName { get; set; } = string.Empty;
    }

    private void CloseModal()
    {
        showAnimalModal = false;
    }

    private void ShowAuth()
    {
        showAuthModal = true;
    }

    private void CloseAuthModal()
    {
        showAuthModal = false;
        authError = "";
    }

    private void ToggleAuthMode()
    {
        isLogin = !isLogin;
        authError = "";
    }

    private async Task HandleAuth()
    {
        authError = "";
        
        try
        {
            AuthResponse result;
            if (isLogin)
            {
                result = await AuthService.LoginAsync(username, password);
            }
            else
            {
                result = await AuthService.RegisterAsync(username, password, nickname);
            }

            if (result.Success)
            {
                CloseAuthModal();
                username = "";
                password = "";
                nickname = "";
            }
            else
            {
                authError = result.Message;
            }
        }
        catch (Exception ex)
        {
            authError = "An error occurred. Please try again.";
            Console.WriteLine($"Auth error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnAuthChanged;
    }
}

<style>
.token-balance {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px;
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    border-radius: 12px;
    margin: 20px auto;
    max-width: 300px;
    box-shadow: 0 4px 12px rgba(251, 191, 36, 0.3);
}

.token-icon {
    font-size: 24px;
}

.token-amount {
    font-size: 20px;
    font-weight: 700;
    color: white;
}

.store-items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 24px;
    margin-top: 32px;
    padding: 0 16px;
}

.gift-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s, box-shadow 0.2s;
}

.gift-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
}

.gift-image-container {
    width: 100%;
    height: 200px;
    background: #f3f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
}

.gift-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.gift-placeholder {
    font-size: 64px;
}

.gift-info {
    padding: 16px;
}

.gift-name {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--foreground);
}

.gift-price {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 16px;
    font-weight: 600;
    color: #f59e0b;
    margin-bottom: 12px;
}

.btn-purchase {
    width: 100%;
    background: var(--primary);
    color: white;
    border: none;
    padding: 12px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-purchase:hover:not(:disabled) {
    background: #6d28d9;
    transform: translateY(-1px);
}

.btn-purchase.btn-disabled {
    background: #9ca3af;
    cursor: not-allowed;
}

.success-modal {
    text-align: center;
    padding: 32px;
}

.success-icon {
    font-size: 64px;
    margin-bottom: 16px;
}

.error-modal {
    text-align: center;
    padding: 32px;
}

.error-icon {
    font-size: 64px;
    margin-bottom: 16px;
}

.remaining-tokens {
    font-size: 18px;
    font-weight: 600;
    color: #f59e0b;
    margin: 16px 0;
}

@@media (max-width: 768px) {
    .store-items-grid {
        grid-template-columns: 1fr;
    }
}
</style>
