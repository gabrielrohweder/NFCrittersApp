@page "/admin"
@using System.Net.Http.Json
@inject HttpClient Http
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Admin - Yume Zoo</PageTitle>

<div class="page-container">
    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Checking permissions...</p>
        </div>
    }
    else if (!isAdmin)
    {
        <div class="auth-required">
            <div class="lock-icon">🔐</div>
            <h2>Access Denied</h2>
            <p>You don't have permission to access this page.</p>
            <button class="btn-primary" @onclick="GoHome">Go Home</button>
        </div>
    }
    else
    {
        <div class="admin-content">
            <h1 class="hero-title">Admin Dashboard</h1>
            
            <div class="admin-tabs">
                <button class="tab-btn @(activeTab == "users" ? "active" : "")" @onclick="SetTabUsers">
                    Users (@users.Count)
                </button>
                <button class="tab-btn @(activeTab == "animals" ? "active" : "")" @onclick="SetTabAnimals">
                    Animals (@animals.Count)
                </button>
            </div>

            @if (activeTab == "users")
            {
                <div class="admin-section">
                    <div class="section-header">
                        <h2>Users</h2>
                    </div>
                    
                    @if (users.Any())
                    {
                        <div class="admin-table-container">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Email</th>
                                        <th>Nickname</th>
                                        <th>Provider</th>
                                        <th>Tokens</th>
                                        <th>Collected</th>
                                        <th>Admin</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in users)
                                    {
                                        <tr>
                                            <td>@user.Username</td>
                                            <td>
                                                @if (editingUserId == user.Id)
                                                {
                                                    <input type="text" @bind="editNickname" class="edit-input" />
                                                }
                                                else
                                                {
                                                    @user.Nickname
                                                }
                                            </td>
                                            <td>@user.AuthProvider</td>
                                            <td>
                                                @if (editingUserId == user.Id)
                                                {
                                                    <input type="number" @bind="editTokens" class="edit-input small" />
                                                }
                                                else
                                                {
                                                    @user.Tokens
                                                }
                                            </td>
                                            <td>@user.CollectedCount</td>
                                            <td>
                                                @if (editingUserId == user.Id)
                                                {
                                                    <input type="checkbox" @bind="editIsAdmin" />
                                                }
                                                else
                                                {
                                                    @(user.IsAdmin ? "Yes" : "No")
                                                }
                                            </td>
                                            <td class="actions-cell">
                                                @if (editingUserId == user.Id)
                                                {
                                                    <button class="btn-small btn-save" @onclick="() => SaveUser(user.Id)">Save</button>
                                                    <button class="btn-small btn-cancel" @onclick="CancelEdit">Cancel</button>
                                                }
                                                else
                                                {
                                                    <button class="btn-small btn-edit" @onclick="() => StartEditUser(user)">Edit</button>
                                                    <button class="btn-small btn-delete" @onclick="() => DeleteUser(user.Id)">Delete</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="no-data">No users found.</p>
                    }
                </div>
            }

            @if (activeTab == "animals")
            {
                <div class="admin-section">
                    <div class="section-header">
                        <h2>Animals</h2>
                        <div class="section-actions">
                            <button class="btn-primary btn-small" @onclick="ShowAddAnimalModal">+ Add Animal</button>
                            <button class="btn-secondary btn-small" @onclick="ShowImportModal">Import CSV</button>
                        </div>
                    </div>
                    
                    @if (animals.Any())
                    {
                        <div class="admin-table-container">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Species</th>
                                        <th>Habitat</th>
                                        <th>Rarity</th>
                                        <th>Token</th>
                                        <th>Collected By</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var animal in animals)
                                    {
                                        <tr>
                                            <td>@animal.Name</td>
                                            <td>@animal.Species</td>
                                            <td>@animal.Habitat</td>
                                            <td><span class="rarity-badge rarity-@animal.Rarity">@animal.Rarity</span></td>
                                            <td><code>@animal.Token</code></td>
                                            <td>@animal.CollectedByCount</td>
                                            <td class="actions-cell">
                                                <button class="btn-small btn-edit" @onclick="() => StartEditAnimal(animal)">Edit</button>
                                                <button class="btn-small btn-delete" @onclick="() => DeleteAnimal(animal.Id)">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="no-data">No animals found.</p>
                    }
                </div>
            }
        </div>
    }

    @if (showAnimalModal)
    {
        <div class="modal-overlay" @onclick="CloseAnimalModal">
            <div class="modal-content admin-modal" @onclick:stopPropagation="true">
                <button class="modal-close" @onclick="CloseAnimalModal">×</button>
                <h2>@(isEditingAnimal ? "Edit Animal" : "Add New Animal")</h2>
                
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" @bind="animalForm.Name" placeholder="Animal name" />
                </div>
                <div class="form-group">
                    <label>Species</label>
                    <input type="text" @bind="animalForm.Species" placeholder="Scientific name" />
                </div>
                <div class="form-group">
                    <label>Habitat</label>
                    <input type="text" @bind="animalForm.Habitat" placeholder="Natural habitat" />
                </div>
                <div class="form-group">
                    <label>Rarity</label>
                    <select @bind="animalForm.Rarity">
                        <option value="common">Common</option>
                        <option value="rare">Rare</option>
                        <option value="legendary">Legendary</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Image URL</label>
                    <input type="text" @bind="animalForm.ImageUrl" placeholder="/images/animal.jpg" />
                </div>
                <div class="form-group">
                    <label>Token (unique identifier for NFC)</label>
                    <input type="text" @bind="animalForm.Token" placeholder="XX001" />
                </div>
                <div class="form-group">
                    <label>Fun Facts (one per line)</label>
                    <textarea @bind="factsText" rows="4" placeholder="Enter each fact on a new line"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(animalError))
                {
                    <p class="error">@animalError</p>
                }

                <div class="modal-actions">
                    <button class="btn-secondary" @onclick="CloseAnimalModal">Cancel</button>
                    <button class="btn-primary" @onclick="SaveAnimal">@(isEditingAnimal ? "Update" : "Create")</button>
                </div>
            </div>
        </div>
    }

    @if (showImportModal)
    {
        <div class="modal-overlay" @onclick="CloseImportModal">
            <div class="modal-content admin-modal" @onclick:stopPropagation="true">
                <button class="modal-close" @onclick="CloseImportModal">×</button>
                <h2>Import Animals from CSV</h2>
                
                <div class="import-instructions">
                    <p>Paste CSV data with the following columns:</p>
                    <code>Name,Species,Habitat,Rarity,ImageUrl,Token,Facts</code>
                    <p class="note">Facts should be separated by semicolons (;)</p>
                </div>

                <div class="form-group">
                    <label>CSV Data</label>
                    <textarea @bind="csvData" rows="10" placeholder="Name,Species,Habitat,Rarity,ImageUrl,Token,Facts"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(importResult))
                {
                    <p class="@(importResult.Contains("Error") ? "error" : "success")">@importResult</p>
                }

                <div class="modal-actions">
                    <button class="btn-secondary" @onclick="CloseImportModal">Cancel</button>
                    <button class="btn-primary" @onclick="ImportAnimals" disabled="@isImporting">
                        @(isImporting ? "Importing..." : "Import")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isAdmin = false;
    private string activeTab = "users";
    private List<AdminUserDTO> users = new();
    private List<AdminAnimalDTO> animals = new();
    
    private string? editingUserId;
    private string editNickname = "";
    private int editTokens = 0;
    private bool editIsAdmin = false;
    
    private bool showAnimalModal = false;
    private bool isEditingAnimal = false;
    private string? editingAnimalId;
    private AnimalFormModel animalForm = new();
    private string factsText = "";
    private string? animalError;
    
    private bool showImportModal = false;
    private string csvData = "";
    private string? importResult;
    private bool isImporting = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckAdminStatus();
    }

    private async Task CheckAdminStatus()
    {
        try
        {
            isLoading = true;
            isAdmin = await Http.GetFromJsonAsync<bool>("/api/admin/check");
            
            if (isAdmin)
            {
                await LoadData();
            }
        }
        catch
        {
            isAdmin = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadData()
    {
        try
        {
            var usersTask = Http.GetFromJsonAsync<List<AdminUserDTO>>("/api/admin/users");
            var animalsTask = Http.GetFromJsonAsync<List<AdminAnimalDTO>>("/api/admin/animals");
            
            await Task.WhenAll(usersTask, animalsTask);
            
            users = usersTask.Result ?? new();
            animals = animalsTask.Result ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading admin data: {ex.Message}");
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private void SetTabUsers()
    {
        activeTab = "users";
    }

    private void SetTabAnimals()
    {
        activeTab = "animals";
    }

    private void GoHome()
    {
        NavigationManager.NavigateTo("/");
    }

    private void StartEditUser(AdminUserDTO user)
    {
        editingUserId = user.Id;
        editNickname = user.Nickname;
        editTokens = user.Tokens;
        editIsAdmin = user.IsAdmin;
    }

    private void CancelEdit()
    {
        editingUserId = null;
    }

    private async Task SaveUser(string userId)
    {
        try
        {
            var request = new { Nickname = editNickname, Tokens = editTokens, IsAdmin = editIsAdmin };
            var response = await Http.PutAsJsonAsync($"/api/admin/users/{userId}", request);
            
            if (response.IsSuccessStatusCode)
            {
                await LoadData();
                editingUserId = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating user: {ex.Message}");
        }
    }

    private async Task DeleteUser(string userId)
    {
        try
        {
            var response = await Http.DeleteAsync($"/api/admin/users/{userId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting user: {ex.Message}");
        }
    }

    private void ShowAddAnimalModal()
    {
        isEditingAnimal = false;
        editingAnimalId = null;
        animalForm = new AnimalFormModel();
        factsText = "";
        animalError = null;
        showAnimalModal = true;
    }

    private void StartEditAnimal(AdminAnimalDTO animal)
    {
        isEditingAnimal = true;
        editingAnimalId = animal.Id;
        animalForm = new AnimalFormModel
        {
            Name = animal.Name,
            Species = animal.Species,
            Habitat = animal.Habitat,
            Rarity = animal.Rarity,
            ImageUrl = animal.ImageUrl,
            Token = animal.Token
        };
        
        try
        {
            var facts = System.Text.Json.JsonSerializer.Deserialize<List<string>>(animal.Facts);
            factsText = string.Join("\n", facts ?? new List<string>());
        }
        catch
        {
            factsText = "";
        }
        
        animalError = null;
        showAnimalModal = true;
    }

    private void CloseAnimalModal()
    {
        showAnimalModal = false;
    }

    private async Task SaveAnimal()
    {
        animalError = null;
        
        if (string.IsNullOrWhiteSpace(animalForm.Name) || string.IsNullOrWhiteSpace(animalForm.Token))
        {
            animalError = "Name and Token are required.";
            return;
        }

        var facts = factsText.Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(f => f.Trim()).ToList();
        var request = new
        {
            animalForm.Name,
            animalForm.Species,
            animalForm.Habitat,
            animalForm.Rarity,
            animalForm.ImageUrl,
            animalForm.Token,
            Facts = facts
        };

        try
        {
            HttpResponseMessage response;
            if (isEditingAnimal && editingAnimalId != null)
            {
                response = await Http.PutAsJsonAsync($"/api/admin/animals/{editingAnimalId}", request);
            }
            else
            {
                response = await Http.PostAsJsonAsync("/api/admin/animals", request);
            }

            if (response.IsSuccessStatusCode)
            {
                await LoadData();
                CloseAnimalModal();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                animalError = error?.Message ?? "Failed to save animal.";
            }
        }
        catch (Exception ex)
        {
            animalError = $"Error: {ex.Message}";
        }
    }

    private async Task DeleteAnimal(string animalId)
    {
        try
        {
            var response = await Http.DeleteAsync($"/api/admin/animals/{animalId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting animal: {ex.Message}");
        }
    }

    private void ShowImportModal()
    {
        csvData = "";
        importResult = null;
        showImportModal = true;
    }

    private void CloseImportModal()
    {
        showImportModal = false;
    }

    private async Task ImportAnimals()
    {
        if (string.IsNullOrWhiteSpace(csvData))
        {
            importResult = "Please enter CSV data.";
            return;
        }

        isImporting = true;
        importResult = null;

        try
        {
            var lines = csvData.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            var animals = new List<object>();

            foreach (var line in lines.Skip(1))
            {
                var parts = ParseCsvLine(line);
                if (parts.Length >= 6)
                {
                    var facts = parts.Length > 6 ? parts[6].Split(';').Select(f => f.Trim()).ToList() : new List<string>();
                    animals.Add(new
                    {
                        Name = parts[0].Trim(),
                        Species = parts[1].Trim(),
                        Habitat = parts[2].Trim(),
                        Rarity = parts[3].Trim().ToLower(),
                        ImageUrl = parts[4].Trim(),
                        Token = parts[5].Trim(),
                        Facts = facts
                    });
                }
            }

            var response = await Http.PostAsJsonAsync("/api/admin/animals/import", animals);
            var result = await response.Content.ReadFromJsonAsync<ImportResult>();
            importResult = result?.Message ?? "Import completed.";
            
            await LoadData();
        }
        catch (Exception ex)
        {
            importResult = $"Error: {ex.Message}";
        }
        finally
        {
            isImporting = false;
        }
    }

    private string[] ParseCsvLine(string line)
    {
        var result = new List<string>();
        var inQuotes = false;
        var current = "";

        foreach (var c in line)
        {
            if (c == '"')
            {
                inQuotes = !inQuotes;
            }
            else if (c == ',' && !inQuotes)
            {
                result.Add(current);
                current = "";
            }
            else
            {
                current += c;
            }
        }
        result.Add(current);
        return result.ToArray();
    }

    private class AdminUserDTO
    {
        public string Id { get; set; } = "";
        public string Username { get; set; } = "";
        public string Nickname { get; set; } = "";
        public string AuthProvider { get; set; } = "";
        public int Tokens { get; set; }
        public bool IsAdmin { get; set; }
        public int CollectedCount { get; set; }
    }

    private class AdminAnimalDTO
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Species { get; set; } = "";
        public string Habitat { get; set; } = "";
        public string Rarity { get; set; } = "";
        public string ImageUrl { get; set; } = "";
        public string Facts { get; set; } = "";
        public string Token { get; set; } = "";
        public int CollectedByCount { get; set; }
    }

    private class AnimalFormModel
    {
        public string Name { get; set; } = "";
        public string Species { get; set; } = "";
        public string Habitat { get; set; } = "";
        public string Rarity { get; set; } = "common";
        public string ImageUrl { get; set; } = "";
        public string Token { get; set; } = "";
    }

    private class ErrorResponse
    {
        public string? Message { get; set; }
    }

    private class ImportResult
    {
        public string? Message { get; set; }
        public int Created { get; set; }
        public int Skipped { get; set; }
    }
}
