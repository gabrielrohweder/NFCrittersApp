@page "/puzzle"
@inject HttpClient Http
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Puzzle - Yume Zoo</PageTitle>

<div class="page-container home-page puzzle-page-container">
    @if (!AuthService.IsAuthenticated)
    {
        <div class="auth-required">
            <div class="lock-icon">🧩</div>
            <h2>Puzzle Locked</h2>
            <p>Create an account to play games and earn tokens!</p>
            <button class="btn-primary" @onclick="GoToGames">
                Go to Games
            </button>
        </div>
    }
    else
    {
        <SlidingPuzzle @ref="puzzleRef"
            N="2"
            ImageUrl="/images/yume_book_3d.webp"
            OnWin="HandlePuzzleWin" />
    }

    @if (showWinModal)
    {
        <div class="modal-overlay" @onclick:stopPropagation="true">
            <div class="modal-content celebration-modal">
                <div class="celebration-icon">🎉</div>
                <h2>Congratulations!</h2>
                <p>You solved the puzzle in @winMoves moves (@winTime)!</p>
                
                @if (!wheelSpinAwarded)
                {
                    <p class="reward-text">You earned a Wheel Spin!</p>
                    <button class="btn-primary" @onclick="AwardWheelSpin">
                        Claim Your Spin! 🎡
                    </button>
                }
                else
                {
                    <p class="reward-text">Wheel spin added to your account!</p>
                    <div class="modal-buttons">
                        <button class="btn-primary" @onclick="GoToWheelSpin">
                            Spin Now! 🎡
                        </button>
                        <button class="btn-secondary" @onclick="PlayAgain">
                            Play Again
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private SlidingPuzzle? puzzleRef;
    private bool showWinModal = false;
    private bool wheelSpinAwarded = false;
    private int winMoves = 0;
    private string winTime = "";

    private void HandlePuzzleWin((int Moves, string Time) result)
    {
        winMoves = result.Moves;
        winTime = result.Time;
        showWinModal = true;
        wheelSpinAwarded = false;
        StateHasChanged();
    }

    private async Task AwardWheelSpin()
    {
        try
        {
            var response = await Http.PostAsync("/api/games/award-wheelspin", null);
            if (response.IsSuccessStatusCode)
            {
                wheelSpinAwarded = true;
                await AuthService.RefreshUserAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error awarding wheel spin: {ex.Message}");
        }
    }

    private void GoToWheelSpin()
    {
        NavigationManager.NavigateTo("/wheelspin");
    }

    private void PlayAgain()
    {
        showWinModal = false;
        wheelSpinAwarded = false;
        puzzleRef?.ResetPuzzle();
        StateHasChanged();
    }

    private void GoToGames()
    {
        NavigationManager.NavigateTo("/games");
    }
}                                                                             