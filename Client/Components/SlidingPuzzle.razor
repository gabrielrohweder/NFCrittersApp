@using System.Diagnostics
@inject NavigationManager Nav

@* -----------------------
   Sliding Tile Game (NxN)
   Config via component parameters (see bottom)
   ----------------------- *@

<div class="page" @onkeydown="OnKeyDown" tabindex="0" @ref="FocusTarget">
  <div class="title">Sliding Tile Game</div>

  <div class="hud" role="status" aria-live="polite">
    <div>Moves: <strong>@Moves</strong></div>
    <div>Time: <strong>@ElapsedText</strong></div>
  </div>

  <div class="board-wrap">
    <div id="board" class="board" style="--N:@N;">
      @for (var pos = 0; pos < Tiles.Length; pos++)
      {
          var pieceId = Tiles[pos];
          var (r, c) = IdxToRC(pos);
          var (hr, hc) = IdxToRC(pieceId); // home row/col for background slice
          var bgX = (N == 1) ? 0 : (double)hc / (N - 1) * 100.0;
          var bgY = (N == 1) ? 0 : (double)hr / (N - 1) * 100.0;
          var isEmpty = (pieceId == N * N - 1);

          <div class="tile @(isEmpty ? "is-empty" : null)"
               role="button"
               style="--r:@r; --c:@c; background-position:@bgX% @bgY%; background-image:@BackgroundCss;"
               @onclick="() => OnTileClick(pos)">
              @if (ShowNumbers && !isEmpty)
              {
                  @((pieceId + 1).ToString())
              }
          </div>
      }
    </div>
    <div class="toast @(ShowToast ? "show" : null)" role="alert" aria-live="assertive">@ToastText</div>
  </div>
</div>

@code {
    // --------------------------
    // Parameters (configure via markup or query string binding if desired)
    // --------------------------
    [Parameter] public int N { get; set; } = 4;                            // 2..10 recommended
    [Parameter] public string ImageUrl { get; set; } = "/images/your-picture.jpg";
    [Parameter] public int ShuffleMovesPerTile { get; set; } = 240;        // shuffle intensity
    [Parameter] public bool ShowNumbers { get; set; } = true;

    // --------------------------
    // State
    // --------------------------
    private int[] Tiles = Array.Empty<int>(); // permutation of [0..N*N-1]
    private int EmptyIndex => Tiles.Length - 1;
    private int Moves = 0;

    private bool DidInitialShuffle = false;
    private bool ShowToast = false;
    private string ToastText = "You win! 🎉";

    private string BackgroundCss => $"url(\"{ImageUrl}\")";

    // Timer / time display
    private readonly Stopwatch Stopwatch = new();
    private System.Timers.Timer? UiTimer;
    private string ElapsedText => FormatTime(Stopwatch.Elapsed);

    // Focus target for keyboard input
    private ElementReference FocusTarget;

    // --------------------------
    // Lifecycle
    // --------------------------
    protected override void OnInitialized()
    {
        N = Math.Clamp(N, 2, 10);
        Tiles = MakeSolved();
        // set up a light UI timer to tick the clock
        UiTimer = new System.Timers.Timer(125);
        UiTimer.Elapsed += (_, __) => InvokeAsync(StateHasChanged);
        UiTimer.AutoReset = true;
        UiTimer.Enabled = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Focus the container so arrow keys work immediately
            await Task.Delay(1);
            await FocusTarget.FocusAsync();

            // Defer the initial shuffle to after first layout
            await Task.Delay(16);
            ShuffleBoard(steps: Math.Max(1, ShuffleMovesPerTile) * N);
            Moves = 0;
            Stopwatch.Restart();
            DidInitialShuffle = true;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        UiTimer?.Dispose();
        Stopwatch.Stop();
    }

    // --------------------------
    // Board helpers
    // --------------------------
    private int[] MakeSolved()
        => Enumerable.Range(0, N * N).ToArray();

    private static (int r, int c) IdxToRC(int idx, int Nlocal) => (idx / Nlocal, idx % Nlocal);
    private (int r, int c) IdxToRC(int idx) => (idx / N, idx % N);
    private int RCToIdx(int r, int c) => r * N + c;

    private IEnumerable<int> NeighborsOf(int idx)
    {
        var (r, c) = IdxToRC(idx);
        if (r > 0) yield return RCToIdx(r - 1, c);
        if (r < N - 1) yield return RCToIdx(r + 1, c);
        if (c > 0) yield return RCToIdx(r, c - 1);
        if (c < N - 1) yield return RCToIdx(r, c + 1);
    }

    private bool IsSolved()
    {
        for (int i = 0; i < Tiles.Length; i++)
            if (Tiles[i] != i) return false;
        return true;
    }

    // --------------------------
    // Actions
    // --------------------------
    private void OnTileClick(int tileIndex)
    {
        if (tileIndex == EmptyIndex) return;
        if (!NeighborsOf(EmptyIndex).Contains(tileIndex)) return;

        Swap(tileIndex, EmptyIndex);
        Moves++;

        if (!Stopwatch.IsRunning && DidInitialShuffle) Stopwatch.Start();

        if (IsSolved())
        {
            Stopwatch.Stop();
            ShowWinToast();
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        var (er, ec) = IdxToRC(EmptyIndex);
        int? targetIndex = null;

        // Move the tile adjacent to empty toward the empty space
        switch (e.Key)
        {
            case "ArrowUp":    if (er < N - 1) targetIndex = RCToIdx(er + 1, ec); break;
            case "ArrowDown":  if (er > 0)     targetIndex = RCToIdx(er - 1, ec); break;
            case "ArrowLeft":  if (ec < N - 1) targetIndex = RCToIdx(er, ec + 1); break;
            case "ArrowRight": if (ec > 0)     targetIndex = RCToIdx(er, ec - 1); break;
        }

        if (targetIndex is int ti)
        {
            Swap(ti, EmptyIndex);
            Moves++;
            if (!Stopwatch.IsRunning && DidInitialShuffle) Stopwatch.Start();

            if (IsSolved())
            {
                Stopwatch.Stop();
                ShowWinToast();
            }
        }
    }

    private void Swap(int a, int b)
    {
        (Tiles[a], Tiles[b]) = (Tiles[b], Tiles[a]);
        StateHasChanged();
    }

    private void ShuffleBoard(int steps)
    {
        // Start from solved
        Tiles = MakeSolved();

        var prev = -1;
        var rng = Random.Shared;
        var empty = EmptyIndex;

        for (int k = 0; k < steps; k++)
        {
            var opts = NeighborsOf(empty).Where(i => i != prev).ToArray();
            var pick = opts[rng.Next(opts.Length)];
            // Swap without counting moves
            (Tiles[pick], Tiles[empty]) = (Tiles[empty], Tiles[pick]);
            prev = empty;
            empty = pick;
        }
        StateHasChanged();
    }

    private static string FormatTime(TimeSpan t)
        => $"{(int)t.TotalMinutes:00}:{t.Seconds:00}";

    private async void ShowWinToast()
    {
        ToastText = $"Solved in {Moves} moves, {ElapsedText} ⏱️";
        ShowToast = true;
        StateHasChanged();
        await Task.Delay(2200);
        ShowToast = false;
        StateHasChanged();
    }
}
